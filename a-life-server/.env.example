# Settings for a-life-server in Docker. Copy this file to .env, next to it, and
# fill it in. .env holds your secrets: keep it to yourself, and out of git
# (.gitignore already leaves it out).

# Your Claude subscription's token, from `claude setup-token` on your own
# machine. The characters' Claude Code sessions run on it, and count towards
# your usage like any other. It's yours alone: don't share an instance.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: a fine-grained GitHub token, with access to only the repositories
# your characters work on (Contents: read and write). git uses it for every
# GitHub address, ssh or https, to clone, fetch and push.
GITHUB_TOKEN=

# Optional: who the characters commit as, if you ask them to commit.
#GIT_AUTHOR_NAME=Your Name
#GIT_AUTHOR_EMAIL=you@example.com
#GIT_COMMITTER_NAME=Your Name
#GIT_COMMITTER_EMAIL=you@example.com

# Optional: the a*life repository the Engineer works on, cloned the first time
# the server starts. Your own fork, if you'd like it to push.
#ALIFE_REPO_URL=https://github.com/q231950/a-life.git

# Optional: dummy characters that play a script, with no Claude at all.
#ALIFE_BACKEND=dummy

# Optional: push notifications to the iPhone and iPad app when a character
# finishes its work, through Apple. All four are needed. The key is the .p8
# file from your Apple developer account: copy it next to docker-compose.yml
# as AuthKey.p8 and uncomment its line under volumes there. See "Push
# notifications" in README.md.
#ALIFE_APNS_KEY_FILE=/home/alife/a-life-apns/AuthKey.p8
#ALIFE_APNS_KEY_ID=ABC1234567
#ALIFE_APNS_TEAM_ID=TEAM123456
#ALIFE_APNS_TOPIC=dev.neoneon.alife
